library(DHARMa)
library(emmeans)
library(ggplot2)
library(dplyr)
analisis_completo_gamma <- function(data, y, titulo = NULL) {
if (is.null(titulo)) {
titulo <- paste("Comparaciones para:", y)
}
# 1. MODELO COMPLETO
formula_str <- reformulate("Medio * Cu * Inoculo", response = y)
modelo <- glm(formula_str,
data = data,
family = Gamma(link = "log"))
# 2. DIAGNÓSTICO DHARMa
message("\n--- Diagnóstico de residuos (DHARMa) ---")
residuos <- simulateResiduals(fittedMod = modelo)
plot(residuos)
# 3. RESUMEN DEL MODELO
message("\n--- Resumen del Modelo (GLM) ---")
print(summary(modelo))
# =========================
# 4. EMMEANS
# =========================
# Medias para gráfico (Medio * Cu dentro de cada Inóculo)
em_med <- emmeans(modelo, ~ Medio * Cu | Inoculo, type = "response")
em_df <- as.data.frame(em_med)
# =========================
# 5. CONTRASTES
# =========================
# A. Medio dentro de cada Cu (y por Inóculo)
message("\n--- Medio dentro de cada Cu ---")
comp_medio <- contrast(em_med, method = "pairwise", by = c("Cu","Inoculo"))
comp_medio_df <- as.data.frame(comp_medio)
print(comp_medio_df)
# B. Inóculo dentro de cada Cu
message("\n--- Inóculo dentro de cada Cu ---")
em_inoculo <- emmeans(modelo, ~ Inoculo | Cu, type = "response")
comp_inoculo <- contrast(em_inoculo, method = "pairwise")
comp_inoculo_df <- as.data.frame(comp_inoculo)
print(comp_inoculo_df)
# C. Comparación entre niveles de Cu
message("\n--- Comparación entre niveles de Cu ---")
em_cu <- emmeans(modelo, ~ Cu, type = "response")
comp_cu <- contrast(em_cu, method = "pairwise")
comp_cu_df <- as.data.frame(comp_cu)
print(comp_cu_df)
# =========================
# 6. FUNCIÓN ESTRELLAS
# =========================
get_stars <- function(p) {
if (is.na(p)) return("")
if (p < 0.001) return("***")
if (p < 0.01)  return("**")
if (p < 0.05)  return("*")
if (p < 0.1)   return(".")
return("ns")
}
comp_medio_df$stars <- sapply(comp_medio_df$p.value, get_stars)
# =========================
# 7. POSICIÓN ANOTACIONES
# =========================
pos_anotaciones <- em_df %>%
group_by(Cu, Inoculo) %>%
summarise(y_text = max(upper.CL, na.rm = TRUE) * 1.15, .groups="drop") %>%
left_join(comp_medio_df, by = c("Cu","Inoculo"))
# =========================
# 8. GRÁFICO
# =========================
p <- ggplot(em_df, aes(x = Medio, y = response, fill = Medio)) +
geom_bar(stat = "identity", alpha = 0.7, color = "black", width = 0.6) +
geom_errorbar(aes(ymin = lower.CL, ymax = upper.CL),
width = 0.2, color = "black") +
geom_text(aes(label = round(response, 2)),
vjust = 1.5, color = "black", fontface = "bold", size = 3.5) +
facet_grid(Inoculo ~ Cu, labeller = label_both) +
theme_minimal() +
labs(
title = titulo,
y = paste("Media estimada de", y),
x = "Medio de Cultivo"
) +
scale_fill_brewer(palette = "Set2") +
theme(legend.position = "none",
plot.title = element_text(face = "bold", size = 13),
strip.text = element_text(face = "bold", size = 11))
# Líneas y estrellas
p <- p +
geom_segment(data = pos_anotaciones,
aes(x = 1, xend = 2,
y = y_text * 0.92, yend = y_text * 0.92),
inherit.aes = FALSE, col = "black", lwd = 0.4) +
geom_text(data = pos_anotaciones,
aes(x = 1.5, y = y_text, label = stars),
inherit.aes = FALSE, size = 5, fontface = "bold")
return(list(
modelo = modelo,
medias = em_df,
medio_contrastes = comp_medio_df,
inoculo_contrastes = comp_inoculo_df,
cu_contrastes = comp_cu_df,
grafico = p
))
}
