analisis_medio_por_cu_gamma <- function(data, y, titulo = NULL) {
if (is.null(titulo)) {
titulo <- paste("Comparación de Medio (vivo vs vitro) según niveles de Cu para:", y)
}
# 1. Ajuste del modelo con INTERACCIÓN (Medio * Cu)
