### Modelos comparativos vivo y vitro###
analisis_medio_gamma <- function(data, y, titulo = NULL) {
# Fijamos la X como "Medio" que es tu objetivo principal
x <- "Medio"
if (is.null(titulo)) {
titulo <- paste("Efecto del Medio sobre", y)
}
# 1. Ajuste del modelo (GLM Gamma con link log)
formula_str <- reformulate(x, response = y)
modelo <- glm(formula_str, data = data, family = Gamma(link = "log"))
# 2. Supuestos con DHARMa
message("\n--- Diagnóstico de residuos (DHARMa) ---")
residuos <- simulateResiduals(fittedMod = modelo)
plot(residuos)
# 3. Resumen estadístico
message("\n--- Resumen del Modelo (GLM) ---")
print(summary(modelo))
# 4. Medias Estimadas (Volviendo a la escala original con type = "response")
specs_med <- as.formula(paste("~", x))
em_med <- emmeans(modelo, specs_med, type = "response")
em_df <- as.data.frame(em_med)
# 5. Contrastes (Comparación in vivo vs in vitro)
message("\n--- Tabla de Contrastes ---")
comparaciones <- contrast(em_med, method = "pairwise")
comp_df <- as.data.frame(comparaciones)
print(comp_df)
# Función interna para asignar estrellas según el p-valor único
get_stars <- function(p) {
if (is.na(p)) return("")
if (p < 0.001) return("***")
if (p < 0.01)  return("**")
if (p < 0.05)  return("*")
if (p < 0.1)   return(".")
return("ns")
}
p_val <- comp_df$p.value[1]
estrellas <- get_stars(p_val)
# Determinar la altura máxima para colocar la etiqueta del p-valor en el gráfico
y_max <- max(em_df$upper.CL, na.rm = TRUE) * 1.1
# 6. Gráfico de barras con barras de error y significancia
p <- ggplot(em_df, aes(x = .data[[x]], y = response, fill = .data[[x]])) +
geom_bar(stat = "identity", alpha = 0.7, color = "black", width = 0.6) +
geom_errorbar(aes(ymin = lower.CL, ymax = upper.CL),
width = 0.2, color = "black") +
# Valor numérico dentro de la barra
geom_text(aes(label = round(response, 2)),
vjust = 1.5, color = "white", fontface = "bold", size = 4.5) +
theme_minimal() +
labs(
title = titulo,
y = paste("Media estimada de", y),
x = "Medio de Cultivo"
) +
scale_fill_brewer(palette = "Set2") +
theme(legend.position = "none",
plot.title = element_text(face = "bold", size = 14))
# Si la diferencia es significativa o marginal, agregamos la anotación arriba
if (estrellas != "") {
p <- p + annotate("text", x = 1.5, y = y_max,
label = estrellas, size = 6, fontface = "bold") +
geom_segment(aes(x = 1, xend = 2, y = y_max * 0.95, yend = y_max * 0.95),
col = "black", lwd = 0.5)
}
return(list(
modelo = modelo,
medias = em_df,
contrastes = comp_df,
grafico = p
))
}
# Para analizar la Frecuencia
resultados_frec <- analisis_medio_gamma(data = DatosInc, y = "Frec")
# Para ver el gráfico generado:
resultados_frec$grafico
