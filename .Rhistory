modelo <- glm(formula_str, data = data, family = Gamma(link = "log"))
# 2. Supuestos con DHARMa
message("\n--- Diagnóstico de residuos (DHARMa) ---")
residuos <- simulateResiduals(fittedMod = modelo)
plot(residuos)
# 3. Resumen estadístico del modelo
